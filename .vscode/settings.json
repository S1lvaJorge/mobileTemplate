{
  // === Formatting & Code Actions ===
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit",
    "source.addMissingImports": "explicit"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  // === TypeScript Configuration ===
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferences.importModuleSpecifier": "relative",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.suggest.autoImports": true,
  "javascript.suggest.autoImports": true,

  // === Editor Behavior ===
  "editor.tabSize": 2,
  "editor.linkedEditing": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.wordWrap": "on",
  "editor.minimap.enabled": false,
  "editor.inlineSuggest.enabled": true,
  "editor.quickSuggestions": {
    "strings": true
  },

  // === File Handling ===
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/.expo": true,
    "**/.expo-shared": true,
    "**/node_modules": true,
    "**/.git": true,
    "**/ios/Pods": true,
    "**/android/.gradle": true,
    "**/android/build": true,
    "**/ios/build": true
  },

  // === React Native Specific ===
  "react-native-tools.showUserTips": false,
  "react-native-tools.projectRoot": "",

  // === Prettier Configuration ===
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // === ESLint Configuration ===
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],

  // === Error Lens (inline errors) ===
  "errorLens.enabledDiagnosticLevels": ["error", "warning"],
  "errorLens.excludeBySource": ["cSpell"],

  // === i18n Ally (your existing config - kept!) ===
  "i18n-ally.localesPaths": [
    "language",
    "language/i18n",
    "language/i18n/locales"
  ],
  "i18n-ally.enabledFrameworks": ["react"],
  "i18n-ally.keystyle": "nested",

  // === Git Configuration ===
  "gitlens.codeLens.enabled": true,
  "gitlens.currentLine.enabled": true,

  // === Search Exclusions ===
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/.expo": true,
    "**/.expo-shared": true,
    "**/ios/Pods": true,
    "**/android/.gradle": true,
    "**/dist": true,
    "**/build": true
  },

  // === Emmet ===
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "typescript": "typescriptreact"
  },
  "emmet.triggerExpansionOnTab": true,

  // === Todo Tree Configuration ===
  "todo-tree.general.tags": ["TODO", "FIXME", "BUG", "HACK", "NOTE"],
  "todo-tree.highlights.defaultHighlight": {
    "gutterIcon": true
  }
}
